{
  "name": "@monorepo/utils",
  "type": "module",
  "version": "0.0.0",
  "description": "Sample utility package",
  "private": true,
  "main": "src/index.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf node_modules dist trace coverage .turbo",
    "build": "tsdown",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsgo",
    "lint": "oxlint . --max-warnings=0",
    "format": "pnpm -w format packages/utils",
    "quality": "pnpm format && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@monorepo/workspace": "workspace:*",
    "jsdom": "catalog:"
  },
  "dependencies": {
    "color2k": "2.0.4"
  }
}
