{
  "name": "@monorepo/ui",
  "type": "module",
  "version": "0.0.0",
  "description": "Design system: theme, static stylesheet and React components",
  "private": true,
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./dist/styles.css"
  },
  "imports": {
    "#test": "./test/index.ts"
  },
  "scripts": {
    "clean": "rimraf node_modules dist trace coverage .turbo storybook-static",
    "build": "node --import ./scripts/resolve-ts.ts scripts/build.ts",
    "prestorybook": "pnpm build",
    "storybook": "storybook dev -p 6006",
    "prebuild:storybook": "pnpm build",
    "build:storybook": "storybook build -o storybook-static",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsgo",
    "lint": "oxlint . --max-warnings=0",
    "format": "pnpm -w format packages/ui",
    "quality": "pnpm format && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@monorepo/utils": "workspace:*"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@monorepo/workspace": "workspace:*",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "vite": "catalog:",
    "vitest-axe": "catalog:"
  }
}
