{
  "$schema": "https://turborepo.dev/schema.v2.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "package.json",
        "src/**/*.{ts,tsx,mts}",
        "!src/**/*.test.{ts,tsx,mts}"
      ],
      "outputs": ["dist/**"]
    },
    "test": {
      "inputs": ["package.json", "**/*.{ts,tsx,mts}"]
    },
    "typecheck": {
      "inputs": ["package.json", "tsconfig.json", "src/**/*.{ts,tsx,mts}"]
    },
    "lint": {
      "inputs": ["package.json", "tsconfig.json", "src/**/*.{ts,tsx,mts}"]
    }
  },
  "globalDependencies": ["tsconfig.json"]
}
