{
  "$schema": "https://turborepo.dev/schema.v2.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "inputs": ["package.json", "**/*.{ts,tsx,mts,css}"]
    },
    "@monorepo/ui#test": {
      "dependsOn": ["build"],
      "inputs": ["package.json", "**/*.{ts,tsx,mts,css}"]
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$"]
    }
  },
  "globalDependencies": ["tsconfig.json"]
}
